# ── Environnement Python ──────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Variables d'environnement & secrets ───────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*_secrets.json
google_client_secrets.json

# ── Base de données locale ────────────────────────────────────────────────────
memory/
*.db
*.sqlite
*.sqlite3

# ── Frontend (Vite / Node) ────────────────────────────────────────────────────
frontend_web/node_modules/
frontend_web/dist/
frontend_web/.vite/
frontend_web/.firebase/
node_modules/
dist/
.vite/

# ── IDE & outils ──────────────────────────────────────────────────────────────
.claude/
.vscode/
.idea/
.adk/
*.suo
*.user
.DS_Store
Thumbs.db
# Fichiers de verrouillage Office (crees quand un .pptx/.docx est ouvert)
~$*

# ── Logs & temporaires ────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*.swo
logs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── ML / données ─────────────────────────────────────────────────────────────
*.pkl
*.joblib
*.h5
*.model
# Modèles LifeSnaps utilisés en prod (chargés par agentic/agents/ml_agent.py,
# embarqués dans l'image Docker) — exception volontaire au *.joblib ci-dessus.
!output/models/*.joblib
data/raw/
data/processed/

# ── Coverage & tests ──────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

reports/*.pdf

# ── Terraform ──────────────────────────────────────────────────────────────────
terraform/.terraform/
terraform/terraform.tfvars
terraform/*.tfplan

# Le state ne doit JAMAIS être commité : il contient en clair le mot de passe
# Postgres, les clés de session/scheduler, les credentials Twilio et le client
# OAuth. En fonctionnement normal il vit uniquement dans le bucket GCS
# (backend distant, voir terraform/versions.tf) — ces règles sont un garde-fou
# au cas où quelqu'un lancerait Terraform avec un backend local.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
# Un fichier *_override.tf peut rediriger le backend vers le disque local :
# on ne veut pas qu'il parte dans le dépôt et contourne le backend distant.
*_override.tf
!terraform/terraform.tfvars.example
# .terraform.lock.hcl reste committé (verrouille les versions de provider)
